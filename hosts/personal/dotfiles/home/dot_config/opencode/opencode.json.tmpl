{
  "$schema": "https://opencode.ai/config.json",

  "plugin": [
    "opencode-wakatime"
  ],

  "share": "manual",
  "autoupdate": "notify",

  "compaction": {
    "auto": true,
    "prune": true
  },

  "provider": {
    "ai-gateway": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Enexis AI Gateway",
      "options": {
        "baseURL": "{env:ENEXIS_AI_GATEWAY_URL}",
        "apiKey": "{env:ENEXIS_AI_GATEWAY_KEY}",
        "timeout": 300000
      },
      "models": {
        "claude-sonnet-4-5": { "name": "claude-sonnet-4-5" },
        "claude-haiku-4-5":  { "name": "claude-haiku-4-5"  },
        "claude-opus-4-5":   { "name": "claude-opus-4-5"   },
        "deepseek-r1-0528":  { "name": "deepseek-r1-0528"  }
      }
    },
    "opencode-go": {},
    "copilot": {}
  },

  "enabled_providers":  ["ai-gateway", "opencode-go", "copilot"],
  "disabled_providers": ["anthropic", "openai", "google", "xai", "amazon-bedrock", "azure", "openrouter"],

  "model": "ai-gateway/claude-sonnet-4-5",
  "small_model": "opencode-go/deepseek-v4-flash",

  "tools": {
    "bash":      true,
    "edit":      true,
    "write":     true,
    "read":      true,
    "grep":      true,
    "glob":      true,
    "task":      true,
    "skill":     true,
    "webfetch":  true,
    "websearch": true
  },

  "permission": {
    "skill":     { "*": "allow" },
    "task":      "allow",
    "webfetch":  "allow",
    "websearch": "allow",
    "external_directory": {
      "~/.config/opencode/*": "allow"
    },
    "bash": {
      "*":                           "ask",
      "git status":                  "allow",
      "git status *":                "allow",
      "git diff":                    "allow",
      "git diff *":                  "allow",
      "git log *":                   "allow",
      "git show *":                  "allow",
      "git add *":                   "allow",
      "git commit *":                "allow",
      "git fetch *":                 "allow",
      "git stash list":              "allow",
      "python *":                    "allow",
      "uv *":                        "allow",
      "pytest *":                    "allow",
      "ruff *":                      "allow",
      "mypy *":                      "allow",
      "node *":                      "allow",
      "npm test":                    "allow",
      "npm run *":                   "allow",
      "terraform fmt":               "allow",
      "terraform validate":          "allow",
      "terraform plan *":            "allow",
      "tofu plan *":                 "allow",
      "helm lint *":                 "allow",
      "helm template *":             "allow",
      "helm diff *":                 "allow",
      "kubectl get *":               "allow",
      "kubectl describe *":          "allow",
      "kubectl logs *":              "allow",
      "kubectl diff *":              "allow",
      "aws sts get-caller-identity": "allow",
      "aws s3 ls *":                 "allow",
      "kubectl apply *":             "ask",
      "helm upgrade *":              "ask",
      "helm install *":              "ask",
      "terraform apply *":           "ask",
      "pip install *":               "ask",
      "npm install *":               "ask",
      "sudo *":                      "deny",
      "rm -rf *":                    "deny",
      "kubectl delete *":            "deny",
      "terraform destroy *":         "deny",
      "helm uninstall *":            "deny",
      "aws iam delete-*":            "deny"
    },
    "read": {
      "*":               "allow",
      "*.env":           "ask",
      "*.env.*":         "ask",
      ".env":            "ask",
      "**/.env":         "ask",
      "*.pem":           "deny",
      "*.key":           "deny",
      "**/secrets*":     "deny",
      "**/*credential*": "deny"
    },
    "write": "ask",
    "edit":  "ask"
  },

  "command": {
    "test": {
      "template": "Run full test suite with coverage. Show failures, suggest fixes.",
      "description": "Run tests"
    },
    "lint": {
      "template": "Run ruff, mypy, terraform fmt. Fix issues found.",
      "description": "Lint and format"
    },
    "review": {
      "template": "@reviewer Review current diff or file for security, NIS2 compliance, and quality. Use full checklist.",
      "description": "Code review"
    },
    "security": {
      "template": "@reviewer Security audit: secrets, EU data residency, unpinned deps, missing auth, LiteLLM bypass.",
      "description": "Security audit"
    },
    "docs": {
      "template": "Write or update docstrings and README for the current module. Be concise.",
      "description": "Generate docs"
    }
  },

  "formatter": {
    "ruff": {
      "command": ["ruff", "check", "--fix", "$FILE"],
      "extensions": [".py"]
    },
    "ruff-format": {
      "command": ["ruff", "format", "$FILE"],
      "extensions": [".py"]
    },
    "terraform": {
      "command": ["terraform", "fmt", "$FILE"],
      "extensions": [".tf", ".tfvars"]
    },
    "prettier-yaml": {
      "command": ["prettier", "--write", "$FILE"],
      "extensions": [".yaml", ".yml"]
    }
  },

  "watcher": {
    "ignore": [
      "__pycache__/**", "*.pyc",
      ".pytest_cache/**", ".mypy_cache/**",
      ".venv/**", "venv/**",
      ".git/**", "*.egg-info/**",
      "dist/**", "build/**",
      ".coverage", "htmlcov/**",
      "target/**", "node_modules/**",
      ".terraform/**", "*.tfstate*",
      ".DS_Store"
    ]
  },

  "lsp": {
    "python": {
      "command": ["pylsp"],
      "extensions": [".py"]
    },
    "terraform": {
      "command": ["terraform-ls", "serve"],
      "extensions": [".tf", ".tfvars"]
    }
  },

  "mcp": {
    "mem0": {
      "type":    "local",
      "command": ["python", "-m", "mem0_mcp.server"],
      "environment": { "MEM0_API_URL": "{env:MEM0_API_URL}" }
    },
    "headroom": {
      "type":    "local",
      "command": ["headroom", "mcp", "serve"],
      "environment": {
        "HEADROOM_OUTPUT_SHAPER": "1",
        "HEADROOM_CACHE_ALIGN":   "1",
        "HEADROOM_LOG_LEVEL":     "warn"
      }
    },
    "gitlab": {
      "type":    "local",
      "command": ["npx", "@modelcontextprotocol/server-gitlab"],
      "environment": {
        "GITLAB_TOKEN": "{env:GITLAB_TOKEN}",
        "GITLAB_URL":   "{env:GITLAB_URL}"
      }
    },
    "searxng": {
      "type":    "local",
      "command": ["npx", "-y", "mcp-searxng"],
      "enabled": false,
      "environment": { "SEARXNG_URL": "http://localhost:8080" }
    }
  },

}
