{
  "debugLog": false,
  "permissionReviewLog": false,
  "yoloMode": true,
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      ".env": "ask",
      "**/.env": "ask",
      "*.pem": "deny",
      "*.key": "deny",
      "**/secrets*": "deny",
      "**/*credential*": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      ".env": "ask",
      "**/.env": "ask",
      "*.pem": "deny",
      "*.key": "deny",
      "**/secrets*": "deny",
      "**/*credential*": "deny"
    },
    "write": "ask",
    "edit": "ask",
    "external_directory": {
      "*": "ask",
      "~/.pi/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/bin/**": "allow"
    },
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git fetch *": "allow",
      "git stash list": "allow",
      "gh *": "allow",
      "rg *": "allow",
      "rtk *": "allow",
      "python *": "allow",
      "uv *": "allow",
      "pytest *": "allow",
      "ruff *": "allow",
      "mypy *": "allow",
      "node *": "allow",
      "npm test": "allow",
      "npm run *": "allow",
      "terraform fmt": "allow",
      "terraform validate": "allow",
      "terraform plan *": "allow",
      "tofu plan *": "allow",
      "helm lint *": "allow",
      "helm template *": "allow",
      "helm diff *": "allow",
      "kubectl get *": "allow",
      "kubectl describe *": "allow",
      "kubectl logs *": "allow",
      "kubectl diff *": "allow",
      "aws sts get-caller-identity": "allow",
      "aws s3 ls *": "allow",
      "kubectl apply *": "ask",
      "helm upgrade *": "ask",
      "helm install *": "ask",
      "terraform apply *": "ask",
      "pip install *": "ask",
      "npm install *": "ask",
      "sudo *": "deny",
      "rm -rf *": "deny",
      "kubectl delete *": "deny",
      "terraform destroy *": "deny",
      "helm uninstall *": "deny",
      "aws iam delete-*": "deny"
    },
    "skill": {
      "*": "allow"
    }
  }
}
