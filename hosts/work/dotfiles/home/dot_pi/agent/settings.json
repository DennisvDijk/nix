{
  "defaultProvider": "ai-gateway",
  "defaultModel": "gpt-5.6-luna",
  "defaultThinkingLevel": "xhigh",
  "theme": "neon-singularity",
  "quietStartup": true,
  "enableInstallTelemetry": false,
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "timeoutMs": 300000,
      "maxRetries": 0
    }
  },
  "enabledModels": [
    "ai-gateway/*",
    "omlx/*"
  ],
  "packages": [
    "npm:pi-web-access",
    "npm:@gotgenes/pi-permission-system",
    "npm:pi-opencode-go-provider",
    "npm:pi-rtk-optimizer",
    "npm:pi-dynamic-workflows",
    "npm:pi-subagents",
    "npm:pi-lens",
    "npm:@vigolium/piolium",
    "npm:@mjasnikovs/pi-task",
    "npm:pi-hermes-memory",
    "npm:pi-mcp-adapter"
  ],
  "enableSkillCommands": true,
  "lastChangelogVersion": "0.81.1"
}
