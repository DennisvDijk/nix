{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "defaultProvider": "ai-gateway",
  "defaultModel": "gpt-5.6-luna",
  "defaultThinkingLevel": "xhigh",
  "quietStartup": true,
  "enableInstallTelemetry": false,
  "retry": {
    "provider": {
      "timeoutMs": 300000
    }
  },
  "enabledModels": [
    "ai-gateway/*",
    "omlx/*"
  ],
  "packages": [
    "npm:pi-worktrunk"
  ]
}
