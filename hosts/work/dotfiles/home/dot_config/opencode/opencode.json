{
  "$schema": "https://opencode.ai/config.json",
  "model": "ai-gateway/claude-sonnet-4.6-bedrock",
  "small_model": "ai-gateway/gpt-5.4-mini",
  "provider": {
    "ai-gateway": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Enexis AI Gateway",
      "options": {
        "baseURL": "{env:ENEXIS_AI_GATEWAY_URL}",
        "apiKey": "{env:ENEXIS_AI_GATEWAY_KEY}",
        "timeout": 300000
      },
      "models": {
        "claude-sonnet-4.6-bedrock": {
          "name": "claude-sonnet-4.6"
        },
        "claude-haiku-4.5-bedrock": {
          "name": "claude-haiku-4.5"
        },
        "claude-opus-4.8-bedrock": {
          "name": "claude-opus-4.8"
        },
        "gpt-5.4": {
          "name": "gpt-5.4"
        },
        "gpt-5.4-mini": {
          "name": "gpt-5.4-mini"
        }
      }
    },
    "github-copilot": {},
    "omlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "oMLX local",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "timeout": 300000
      },
      "models": {
        "qwen3.6-35B-A3B-4bit": {
          "name": "Qwen3.6-35B-A3B",
          "limit": {
            "context": 65536,
            "output": 4096
          }
        },
        "qwen3.6-27b-4bit": {
          "name": "qwen3.6-27b-4bit"
        }
      }
    }
  },
  "enabled_providers": [
    "ai-gateway",
    "github-copilot",
    "omlx"
  ],
  "disabled_providers": [
    "anthropic",
    "openai",
    "google",
    "xai",
    "amazon-bedrock",
    "azure",
    "openrouter"
  ],
  "permission": {
    "skill": {
      "*": "allow"
    },
    "task": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": {
      "~/.config/opencode/*": "allow"
    },
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git fetch *": "allow",
      "git stash list": "allow",
      "python *": "allow",
      "uv *": "allow",
      "pytest *": "allow",
      "ruff *": "allow",
      "mypy *": "allow",
      "node *": "allow",
      "npm test": "allow",
      "npm run *": "allow",
      "terraform fmt": "allow",
      "terraform validate": "allow",
      "terraform plan *": "allow",
      "tofu plan *": "allow",
      "helm lint *": "allow",
      "helm template *": "allow",
      "helm diff *": "allow",
      "kubectl get *": "allow",
      "kubectl describe *": "allow",
      "kubectl logs *": "allow",
      "kubectl diff *": "allow",
      "aws sts get-caller-identity": "allow",
      "aws s3 ls *": "allow",
      "kubectl apply *": "ask",
      "helm upgrade *": "ask",
      "helm install *": "ask",
      "terraform apply *": "ask",
      "pip install *": "ask",
      "npm install *": "ask",
      "sudo *": "deny",
      "rm -rf *": "deny",
      "kubectl delete *": "deny",
      "terraform destroy *": "deny",
      "helm uninstall *": "deny",
      "aws iam delete-*": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      ".env": "ask",
      "**/.env": "ask",
      "*.pem": "deny",
      "*.key": "deny",
      "**/secrets*": "deny",
      "**/*credential*": "deny"
    },
    "write": "ask",
    "edit": "ask"
  },
  "mcp": {
    "mem0": {
      "type": "local",
      "command": [
        "python",
        "-m",
        "mem0_mcp.server"
      ],
      "environment": {
        "MEM0_API_URL": "{env:MEM0_API_URL}"
      }
    },
    "headroom": {
      "type": "local",
      "command": [
        "headroom",
        "mcp",
        "serve"
      ],
      "environment": {
        "HEADROOM_OUTPUT_SHAPER": "1",
        "HEADROOM_CACHE_ALIGN": "1",
        "HEADROOM_LOG_LEVEL": "warn"
      }
    },
    "gitlab": {
      "type": "local",
      "command": [
        "npx",
        "@modelcontextprotocol/server-gitlab"
      ],
      "environment": {
        "GITLAB_TOKEN": "{env:GITLAB_TOKEN}",
        "GITLAB_URL": "{env:GITLAB_URL}"
      }
    },
    "searxng": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-searxng"
      ],
      "enabled": false,
      "environment": {
        "SEARXNG_URL": "http://localhost:8080"
      }
    }
  }
}
